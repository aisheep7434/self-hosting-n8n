# 数据库超级用户配置
POSTGRES_USER=postgres                # 数据库超级用户名，默认为postgres，一般不需要修改
POSTGRES_PASSWORD=postgres_password   # 数据库超级用户密码，必须修改为您自己的强密码

# n8n应用使用的数据库配置
POSTGRES_DB=n8n                       # n8n使用的数据库名称，默认为n8n，一般不需要修改
POSTGRES_NON_ROOT_USER=n8n_user       # n8n应用使用的数据库用户名，默认为n8n_user，一般不需要修改
POSTGRES_NON_ROOT_PASSWORD=n8n_password # n8n应用使用的数据库用户密码，必须修改为您自己的强密码

# 系统配置
TZ=Asia/Shanghai                      # 时区设置，默认为中国标准时间，根据需要可以修改
N8N_PORT=5678                         # n8n应用的访问端口，如果此端口已被占用，需要修改为其他未使用的端口

# Webhook配置 (与NGROK_DOMAIN保持一致)
WEBHOOK_URL=your-domain.ngrok-free.app  # 外部访问n8n的URL地址，必须与NGROK_DOMAIN保持一致

# Ngrok隧道配置 (需要在ngrok官网注册并获取)
NGROK_AUTHTOKEN=your_ngrok_auth_token_here  # 从ngrok官网获取的授权令牌，用于建立安全隧道
NGROK_DOMAIN=your-domain.ngrok-free.app     # 您在ngrok注册的自定义域名，用于外部访问您的n8n实例
