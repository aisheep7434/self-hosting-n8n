# ===============================================================
# 基础配置 (请务必修改)
# 把这里想象成你的保险柜，需要设置两套密码
# ===============================================================

# 1. 数据库管理员 (超级管理员)
# 这是数据库的“总钥匙”，拥有最高权限。请设置一个复杂的密码。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# 2. 数据库普通用户 (给 n8n 程序使用)
# 这是 n8n 程序每天用来访问数据库的“日常钥匙”，权限较低，更安全。
# 建议设置与管理员不同的密码。
POSTGRES_DB=n8n
POSTGRES_NON_ROOT_USER=n8n_user
POSTGRES_NON_ROOT_PASSWORD=n8n_password

# ===============================================================
# n8n 应用配置 (根据你的情况修改)
# ===============================================================

# 3. 时区设置
# 设置你所在地区的时区，这样 n8n 里的时间才会显示正确。
# 例如，中国是 "Asia/Shanghai"。
TZ=Asia/Shanghai

# 4. n8n 访问端口
# 这是你通过设备 IP 访问 n8n 的“门牌号”。
# 比如，如果你的设备 IP 是 192.168.1.100，这里设置为 5678，那你就可以通过 http://192.168.1.100:5678 访问 n8n。
# 如果 5678 端口被占用了，可以改成其他数字，比如 5679。
N8N_PORT=5678

# 5. 外部访问域名 (高级功能，通常需要配合 Cloudflare 使用)
# 这是 n8n 用来接收外部信号（Webhook）的地址。
# 如果你不知道这是什么，或者你没有自己的域名，请暂时不要修改它，并保持 docker-compose.yml 文件中对应的 WEBHOOK_URL 行为注释状态。
# 格式必须是：https://your.domain.com
WEBHOOK_URL=https://your-domain.com
